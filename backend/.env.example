# ABO Enterprise Backend Environment Variables

# App
APP_NAME="ABO Enterprise API"
APP_ENV=development
DEBUG=false
SECRET_KEY=your-super-secret-key-min-32-chars-change-this
ALLOWED_ORIGINS=http://localhost:3000,https://aboenterprise.com

# Supabase
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin
ADMIN_EMAIL=admin@aboenterprise.com
ADMIN_PASSWORD=change-this-strong-password

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Business
WHATSAPP_NUMBER=8801825007977
BUSINESS_EMAIL=info@aboenterprise.com

# GA4 Data API — admin Visitor Analytics tab (optional; feature degrades gracefully)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Database backup (Admin → ডাটাবেস Backup) — all optional
# BACKUP_DATABASE_URL=   # session pooler URL (port 5432) or a read-only user; default: DATABASE_URL (6543 → 5432)
# BACKUP_API_URL=https://api.aboenterprise.com   # used for the OAuth Redirect URI shown in the admin
# BACKUP_PG_BIN_DIR=     # use local pg_dump/pg_restore instead of the pinned download (dev PCs)
# One-click "connect drive" (set once; the admin then only clicks Connect → Allow):
# BACKUP_GOOGLE_CLIENT_ID= / BACKUP_GOOGLE_CLIENT_SECRET=
# BACKUP_ONEDRIVE_CLIENT_ID= / BACKUP_ONEDRIVE_CLIENT_SECRET=
# BACKUP_DROPBOX_CLIENT_ID= / BACKUP_DROPBOX_CLIENT_SECRET=
# BACKUP_SCHEDULER=on    # built-in daily scheduler (production only); "off" to disable
