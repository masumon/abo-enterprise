    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --testPathPattern=__tests__",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-splash": "node scripts/generate-splash.mjs",
    "generate-pwa": "node scripts/generate-icons.mjs && node scripts/generate-splash.mjs"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^3.6.0",
    "autoprefixer": "^10.4.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "16.4.0",
    "postcss": "^8.4.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.52.0",
    "swiper": "^14.0.6",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.4.0",
    "tailwindcss": "^3.4.0",
    "tesseract.js": "^5.1.1",
